{
  "name": "@penx1/dsh-bundle",
  "version": "0.1.0",
  "description": "PEN-X1 插件 Bundle：统一挂载 17 个插件的 cordis.yml 与加载入口",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.yml": "./cordis.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@penx1/contracts": "workspace:*",
    "@penx1/dsh-analysis": "workspace:*",
    "@penx1/dsh-core": "workspace:*",
    "@penx1/dsh-data": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
